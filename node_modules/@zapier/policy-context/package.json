{
  "name": "@zapier/policy-context",
  "version": "1.2.2",
  "description": "Shared request context types, builders, and policy condition generators for sdkapi and approvalsapi",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/zapier/zapier-sdk/approvalsapi.git",
    "directory": "packages/policy-context"
  },
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zapier/policy-schema": "0.15.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@zapier/policy": "0.13.0",
    "tsup": "^8.0.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/**/*.ts",
    "fmt": "prettier --write \"**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest watch --clearScreen=false",
    "types": "tsc",
    "types:watch": "tsc --watch"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts"
}