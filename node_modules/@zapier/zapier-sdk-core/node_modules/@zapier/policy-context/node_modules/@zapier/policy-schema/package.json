{
  "name": "@zapier/policy-schema",
  "version": "0.12.0",
  "description": "Zod schemas and TypeScript types for the Zapier policy engine",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/zapier/team-identity-platform/policy.git",
    "directory": "typescript/schema"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch --clearScreen=false",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "fmt": "prettier --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dump-schema": "tsx scripts/dump-schema.ts"
  }
}